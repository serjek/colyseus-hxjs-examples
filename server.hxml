-cp src
-main MainServer
-dce full
-lib colyseus-hxjs
-lib hxnodejs

-D no-deprecation-warnings
-D js-source-map

# Schema codegen: generates TypeScript stubs for client schema generation
# Comment out these lines to disable
-D schema-codegen-output=generated/schemas
--macro colyseus.server.schema.SchemaCodegen.generate()

-js bin/server/index.js